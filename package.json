    "@mui/material": "^7.3.7",
    "@mui/x-date-pickers": "^8.26.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.19",
    "jquery": "^4.0.0",
    "jsdom": "^29.1.1",
