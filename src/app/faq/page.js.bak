'use client';

import { useState } from 'react';

export default function FAQPage() {
  const [activeCategory, setActiveCategory] = useState('general');
  const [openItems, setOpenItems] = useState([]);

  const toggleItem = (index) => {
    setOpenItems(prev => 
      prev.includes(index) 
        ? prev.filter(i => i !== index)
        : [...prev, index]
    );
  };

  const faqCategories = {
    general: [
      {
        question: 'What is {siteConfig.siteName}?',
        answer: '{siteConfig.siteName} is a comprehensive financial services platform that provides investment advisory, mutual fund investments, tax planning, and other financial solutions to help individuals achieve their financial goals.'
      },
      {
        question: 'Is my money safe with {siteConfig.siteName}?',
        answer: 'Yes, all investments are made through SEBI-regulated entities. We follow strict security protocols and your funds are held with authorized custodians. We are also registered with relevant financial authorities.'
      },
      {
        question: 'What are the fees?',
        answer: 'Our fee structure is transparent and varies based on services. For mutual fund investments, we may earn trail commissions from AMCs. Advisory services may have separate fees. All charges are disclosed upfront.'
      },
      {
        question: 'Can I access my account from multiple devices?',
        answer: 'Yes, you can access your account from any device - web browser, iOS app, or Android app. All your data is securely synced across devices.'
      }
    ],
    investing: [
      {
        question: 'What is the minimum investment amount?',
        answer: 'For mutual fund SIPs, the minimum is typically ₹500 per month. For lumpsum investments, the minimum varies by fund but usually starts from ₹1000. Some debt funds may have higher minimums.'
      },
      {
        question: 'How do I start investing?',
        answer: '1. Complete KYC verification 2. Add funds to your investment account 3. Choose from recommended funds or explore options 4. Start SIP or make lumpsum investment 5. Monitor your portfolio regularly'
      },
      {
        question: 'What is KYC and why is it required?',
        answer: 'KYC (Know Your Customer) is a mandatory process as per SEBI regulations. It involves verifying your identity and address to prevent financial fraud. This is a one-time process for all mutual fund investments.'
      },
      {
        question: 'Can I pause or stop my SIP?',
        answer: 'Yes, you can pause or stop your SIP anytime. The process can be initiated from your dashboard. Changes typically take effect from the next billing cycle.'
      }
    ],
    accounts: [
      {
        question: 'How do I reset my password?',
        answer: 'Click on "Forgot Password" on the login page. Enter your registered email address. You will receive a password reset link. Follow the instructions in the email to set a new password.'
      },
      {
        question: 'How do I update my personal information?',
        answer: 'Go to Profile Settings → Personal Details. You can update contact information. For KYC details like name or address, you may need to submit supporting documents.'
      },
      {
        question: 'Is there a mobile app?',
        answer: 'Yes, we have mobile apps for both iOS and Android. You can download them from the App Store or Google Play Store. All features are available on the mobile app.'
      },
      {
        question: 'How do I download my account statements?',
        answer: 'Go to Documents → Account Statements. Select the date range and statement type. You can download PDF statements or view them online. Statements are available for up to 7 years.'
      }
    ],
    transactions: [
      {
        question: 'How long does it take for investments to reflect?',
        answer: 'Lumpsum investments: Usually 1-2 business days. SIP registrations: Activated from the next billing cycle. NAV is applied based on the day your funds are received by the AMC.'
      },
      {
        question: 'What payment methods are accepted?',
        answer: 'We accept UPI, Net Banking, Debit Cards, and NEFT/RTGS transfers. Credit cards are not accepted for mutual fund investments as per SEBI regulations.'
      },
      {
        question: 'Can I redeem my investments anytime?',
        answer: 'Most mutual funds (except ELSS which has 3-year lock-in) can be redeemed anytime. Redemption requests are typically processed within 1-3 business days.'
      },
      {
        question: 'Are there any exit loads?',
        answer: 'Some funds may have exit loads if redeemed within a specific period (usually 1 year). Exit loads vary by fund and are disclosed in the scheme information document.'
      }
    ]
  };

  const categories = [
    { id: 'general', name: 'General', count: faqCategories.general.length },
    { id: 'investing', name: 'Investing', count: faqCategories.investing.length },
    { id: 'accounts', name: 'Accounts', count: faqCategories.accounts.length },
    { id: 'transactions', name: 'Transactions', count: faqCategories.transactions.length }
  ];

  return (
    <div className="min-h-screen bg-gray-50 py-12">
      <div className="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div className="text-center mb-12">
          <h1 className="text-4xl font-bold text-gray-900 mb-4">Frequently Asked Questions</h1>
          <p className="text-xl text-gray-600">Find answers to common questions</p>
        </div>
        
        {/* Category Tabs */}
        <div className="flex flex-wrap justify-center gap-3 mb-8">
          {categories.map(category => (
            <button
              key={category.id}
              onClick={() => setActiveCategory(category.id)}
              className={`px-6 py-3 rounded-lg font-medium transition-colors ${
                activeCategory === category.id
                  ? 'bg-blue-600 text-white'
                  : 'bg-white text-gray-700 border border-gray-300 hover:bg-gray-50'
              }`}
            >
              {category.name} ({category.count})
            </button>
          ))}
        </div>
        
        {/* FAQ Items */}
        <div className="space-y-4">
          {faqCategories[activeCategory].map((item, index) => (
            <div key={index} className="bg-white rounded-xl shadow-lg overflow-hidden">
              <button
                onClick={() => toggleItem(index)}
                className="w-full px-6 py-5 text-left flex justify-between items-center hover:bg-gray-50 transition-colors"
              >
                <span className="text-lg font-medium text-gray-900">{item.question}</span>
                <span className="text-gray-500">
                  {openItems.includes(index) ? '−' : '+'}
                </span>
              </button>
              
              {openItems.includes(index) && (
                <div className="px-6 py-4 bg-gray-50 border-t border-gray-200">
                  <p className="text-gray-700">{item.answer}</p>
                </div>
              )}
            </div>
          ))}
        </div>
        
        {/* Still Have Questions */}
        <div className="mt-12 bg-gradient-to-r from-blue-500 to-blue-700 rounded-2xl p-8 text-white text-center">
          <h2 className="text-2xl font-bold mb-4">Still Have Questions?</h2>
          <p className="text-blue-100 mb-6">
            Can't find the answer you're looking for? Our support team is here to help.
          </p>
          <div className="flex justify-center gap-4">
            <button 
              onClick={() => window.location.href = '/contact'}
              className="px-6 py-3 bg-white text-blue-600 font-semibold rounded-lg hover:bg-gray-100 transition-colors"
            >
              Contact Support
            </button>
            <button className="px-6 py-3 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors">
              Live Chat
            </button>
          </div>
        </div>
      </div>
    </div>
  );
}