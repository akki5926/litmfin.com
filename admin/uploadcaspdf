<?php
// Check if a file was uploaded
if ($_FILES["pdf-file"]["error"] == UPLOAD_ERR_OK) {
    // Get the IIN number
    $iin = $_POST["iin"];

    // Move the uploaded file to the appropriate location
    $tmp_name = $_FILES["pdf-file"]["tmp_name"];
    $path = "uploads/$iin.pdf";
    move_uploaded_file($tmp_name, $path);

    // Return a success response
    echo "OK";
} else {
    // Return an error response
    echo "Upload failed: " . $_FILES["pdf-file"]["error"];
}
?>
